# ========== Web Server ==========
PORT=3000
# Rahasia untuk menandatangani token sesi
TOKEN_SECRET=ganti-dengan-string-panjang-acak
# Base URL site (untuk Socket.io saat production)
PUBLIC_URL=

# ========== Database ==========
# Kosongkan kalau mau pakai SQLite (otomatis tersimpan di data.sqlite)
# Isi dengan URL Postgres untuk production (Render/Railway/Neon), contoh:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=

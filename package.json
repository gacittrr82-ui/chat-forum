{
  "name": "hidden-society-forums",
  "version": "2.0.0",
  "description": "HIDDEN SOCIETY Forums — chat forum anonim realtime (Node.js + Express + Socket.io)",
  "main": "server.js",
  "type": "commonjs",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:exe": "pkg . --targets node18-win-x64 --output build/hidden-society.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  }
}
